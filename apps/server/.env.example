# Copy to apps/server/.env for local development. The server does not load this
# file automatically; export it through your shell/process manager. Never commit
# real production credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Local PostgreSQL example only. Use a secret-managed TLS URL in production.
DATABASE_URL=postgres://anagrams:anagrams@127.0.0.1:5432/anagrams

# Exact comma-separated browser origins; never use `*` with cookie credentials.
WEB_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Local HTTP needs false. Omit in production so NODE_ENV=production forces it.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
INVITATION_TTL_MINUTES=1440

# Enable only behind a controlled proxy that overwrites forwarding headers.
TRUST_PROXY=false
